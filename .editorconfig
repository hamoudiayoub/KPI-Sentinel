# https://editorconfig.org — shared editing conventions (see docs/03-engineering-standards.md §7)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# google-java-format requires 2 spaces; the Python and SQL tools expect 4.
[*.{py,pyi,sql}]
indent_size = 4

[Makefile]
indent_style = tab

# Trailing spaces are meaningful in Markdown (line break); keep them.
[*.md]
trim_trailing_whitespace = false

# Windows scripts must keep CRLF line endings.
[*.{cmd,bat}]
end_of_line = crlf
