# Local environment of the KPI Sentinel stack.
# Copy to .env (never committed) and adjust if a port is already taken on your machine:
#   cp infra/compose/.env.example infra/compose/.env
# Every credential below is a dummy value for local development only.

COMPOSE_PROJECT_NAME=kpi-sentinel

# --- Source system: simulated ERP (profile core) -------------------------------------
POSTGRES_SOURCE_PORT=5432
POSTGRES_SOURCE_PASSWORD=source-local-only
DEBEZIUM_DB_PASSWORD=debezium-local-only
EVENT_GENERATOR_PORT=8094

# --- Platform database: platform, keycloak, nessie, dagster (profile core) ------------
POSTGRES_PLATFORM_PORT=5433
POSTGRES_PLATFORM_PASSWORD=platform-admin-local-only
PLATFORM_DB_PASSWORD=platform-local-only
KEYCLOAK_DB_PASSWORD=keycloak-local-only
NESSIE_DB_PASSWORD=nessie-local-only
DAGSTER_DB_PASSWORD=dagster-local-only

# --- Ingestion (profile core) --------------------------------------------------------
KAFKA_1_PORT=9092
KAFKA_2_PORT=9094
KAFKA_3_PORT=9096
KAFKA_UI_PORT=8080
KAFKA_CONNECT_PORT=8083

# --- Lakehouse (profile lake) --------------------------------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
NESSIE_PORT=19120
TRINO_PORT=8088
SPARK_UI_PORT=4040
DAGSTER_PORT=3000

# --- Platform (profile platform) -----------------------------------------------------
KEYCLOAK_PORT=8180
PLATFORM_API_PORT=8090
AGENT_SERVICE_PORT=8091
ANOMALY_DETECTOR_PORT=8092
WEB_PORT=5173
MAILPIT_PORT=8025

# --- Observability (profile obs) -----------------------------------------------------
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
TEMPO_PORT=3200
LOKI_PORT=3100

# --- LLM provider used by agent-service --------------------------------------------
# Put your own key in .env only. Leave empty to run without the agent.
ANTHROPIC_API_KEY=
